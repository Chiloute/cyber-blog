---
interface Props {
  title?: string;
}
const { title = 'Spoiler' } = Astro.props;
---
<details class="not-prose my-6 rounded border border-border-ui bg-surface p-4">
  <summary class="min-h-6 cursor-pointer font-bold">{title}</summary>
  <div class="mt-3 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2"><slot /></div>
</details>
