---
// Progressive enhancement: without JS this is a closed <details> (flag reachable, not visible).
// src/scripts/flag.ts replaces it with an aria-expanded button + hidden <code> + live region.
interface Props {
  value: string;
  label?: string;
}
const { value, label = 'Flag' } = Astro.props;
---
<div data-flag data-label={label} class="not-prose my-6 flex flex-wrap items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3">
  <details>
    <summary class="min-h-6 cursor-pointer font-mono text-sm font-bold hover:text-accent">Reveal {label.toLowerCase()}</summary>
    <code translate="no" class="mt-2 inline-block break-all [overflow-wrap:anywhere]">{value}</code>
  </details>
</div>
<script>
  import '../../scripts/flag.ts';
</script>
