---
// API: <Terminal title="kali" prompt="$" commands={[{ cmd: 'nmap -sV target', output: '80/tcp open http' }]} />
// `output` is optional. Copy button (copy-code.ts) copies commands only, never prompts or output.
interface Props {
  prompt?: string;
  title?: string;
  commands: { cmd: string; output?: string }[];
}
const { prompt = '$', title, commands } = Astro.props;
---
<div class="not-prose code-block">
  <div data-copy-wrap>
    <div data-code-bar class="code-bar">
      <span aria-hidden="true" class="flex items-center"><span class="code-dots"><span></span><span></span><span></span></span>{title ?? 'terminal'}</span>
    </div>
    <pre data-terminal tabindex="0" role="region" aria-label={title ? `Terminal: ${title}` : 'Terminal'} class="text-[0.875rem]">{commands.map((c) => (
      <><span class="block"><span aria-hidden="true" class="select-none text-accent">{prompt} </span><span data-cmd class="font-bold">{c.cmd}</span></span>{c.output && <span class="mb-2 block whitespace-pre text-muted">{c.output}</span>}</>
    ))}</pre>
  </div>
</div>
<script>
  import '../../scripts/copy-code.ts';
</script>
