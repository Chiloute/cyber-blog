---
// API: <Terminal title="kali" prompt="$" commands={[{ cmd: 'nmap -sV target', output: '80/tcp open http' }]} />
// `output` is optional. Copy button (copy-code.ts) copies commands only, never prompts or output.
interface Props {
  prompt?: string;
  title?: string;
  commands: { cmd: string; output?: string }[];
}
const { prompt = '$', title, commands } = Astro.props;
---
<figure class="not-prose my-6">
  {title && <figcaption class="rounded-t border border-b-0 border-border bg-surface px-3 py-1 text-sm text-muted">{title}</figcaption>}
  <div data-copy-wrap>
    <pre data-terminal tabindex="0" role="region" aria-label={title ? `Terminal: ${title}` : 'Terminal'} class="m-0 font-mono text-sm">{commands.map((c) => (
      <><span class="block"><span aria-hidden="true" class="select-none text-muted">{prompt} </span><span data-cmd>{c.cmd}</span></span>{c.output && <span class="block whitespace-pre text-muted">{c.output}</span>}</>
    ))}</pre>
  </div>
</figure>
<script>
  import '../../scripts/copy-code.ts';
</script>
