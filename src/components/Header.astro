---
import MobileNav from './MobileNav.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  ['writeups', '/writeups'],
  ['notes', '/notes'],
  ['projects', '/projects'],
  ['about', '/about'],
  ['search', '/search'],
] as const;
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href + '/');
// Prompt path follows the current section: chiloute@redteam:~/writeups$
const section = links.find(([, href]) => active(href))?.[1] ?? '';
---

<header class="border-b border-border bg-bg">
  <div class="shell flex flex-wrap items-center gap-x-6 gap-y-3 py-3">
    <a href="/" class="target-min mr-auto font-mono text-[0.9375rem] font-bold text-text no-underline">
      <span class="text-accent">chiloute</span><span aria-hidden="true" class="font-normal text-muted">@redteam:<span class="text-highlight">~{section}</span>$</span><span class="sr-only">, home</span>
    </a>
    <MobileNav controls="main-nav-list" />
    <nav aria-label="Main" class="order-last w-full md:order-none md:w-auto">
      <ul id="main-nav-list" class="m-0 flex list-none flex-col gap-1 p-0 font-mono text-sm max-md:data-collapsed:hidden md:flex-row md:gap-1">
        {
          links.map(([label, href]) => (
            <li>
              <a
                href={href}
                aria-current={active(href) ? 'page' : undefined}
                class="target-min rounded px-2 py-1 text-text no-underline hover:bg-surface hover:text-accent aria-[current=page]:bg-highlight-bg aria-[current=page]:text-text"
              >
                <span aria-hidden="true" class="text-muted">./</span>{label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
