---
import MobileNav from './MobileNav.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  ['Writeups', '/writeups'],
  ['Notes', '/notes'],
  ['Projects', '/projects'],
  ['About', '/about'],
  ['Search', '/search'],
] as const;
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="border-b border-(--border) px-4 py-3">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <a href="/" class="target-min font-mono font-bold text-(--accent) no-underline">
      <span aria-hidden="true">~/</span>chiloute
    </a>
    <MobileNav controls="main-nav-list" />
    <nav aria-label="Main" class="w-full md:w-auto">
      <ul id="main-nav-list" class="m-0 flex list-none flex-col gap-1 p-0 max-md:data-collapsed:hidden md:flex-row md:gap-4">
        {
          links.map(([label, href]) => (
            <li>
              <a href={href} aria-current={active(href) ? 'page' : undefined} class="target-min py-1 aria-[current=page]:font-bold aria-[current=page]:underline">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
