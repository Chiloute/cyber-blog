---
import MobileNav from './MobileNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import Prompt from './Prompt.astro';

const links = [
  ['writeups', '/writeups/'],
  ['notes', '/notes/'],
  ['projects', '/projects/'],
  ['about', '/about/'],
  ['search', '/search/'],
] as const;
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
// Prompt path follows the current section: chiloute@redteam:~/writeups$
const section = links.find(([, href]) => active(href))?.[1].slice(0, -1) ?? '';
---

<header class="border-b border-border bg-bg">
  <div class="shell flex flex-wrap items-center gap-x-6 gap-y-3 py-3">
    <a href="/" class="target-min mr-auto font-mono text-[0.9375rem] font-bold text-text no-underline">
      <Prompt section={section} /><span class="sr-only">, home</span>
    </a>
    <MobileNav controls="site-menu" />
    <!-- Collapsed below md once mobile-nav.ts runs (data-collapsed); always visible without JS and on desktop. -->
    <div id="site-menu" class="order-last flex w-full flex-col gap-3 max-md:data-collapsed:hidden md:order-none md:w-auto md:flex-row md:items-center md:gap-6">
    <nav aria-label="Main">
      <ul class="m-0 flex list-none flex-col gap-1 p-0 font-mono text-sm md:flex-row md:gap-1">
        {
          links.map(([label, href]) => (
            <li>
              <a
                href={href}
                aria-current={active(href) ? 'page' : undefined}
                class="target-min rounded px-2 py-1 text-text no-underline hover:bg-surface hover:text-accent aria-[current=page]:bg-highlight-bg aria-[current=page]:text-text"
              >
                <span aria-hidden="true" class="text-muted">./</span>{label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
    </div>
  </div>
</header>
