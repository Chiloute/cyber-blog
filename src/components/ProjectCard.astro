---
import ExternalLink from './ExternalLink.astro';
import type { Project } from '../lib/projects.ts';

interface Props {
  project: Project;
  /** Heading level, to match the page outline. */
  level?: 2 | 3;
  /** Whether an MDX page exists under /projects/: the title then links there, GitHub becomes secondary. */
  hasDetails?: boolean;
  /** Dense variant for the home page. */
  compact?: boolean;
}
const { project: p, level = 2, hasDetails = false, compact = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const full = `${p.owner}/${p.name}`;
// With a details page the title link stretches over the whole card (same pattern as PostCard); secondary links sit above it.
const title = 'text-text no-underline group-hover:text-accent group-hover:underline';
---

<article class:list={['group relative flex h-full flex-col gap-3 rounded-lg border border-border bg-bg', hasDetails ? 'hover:border-accent' : 'hover:border-border-ui', compact ? 'p-4' : 'p-5']}>
  <Heading class="m-0 font-mono text-base font-bold">
    {hasDetails
      ? <a href={`/projects/${p.slug}/`} class:list={[title, 'after:absolute after:inset-0']}><span class="font-normal text-muted">{p.owner}/</span>{p.name}</a>
      : <ExternalLink href={p.url} newTab class={title}><span class="sr-only">{full} on GitHub</span><span aria-hidden="true"><span class="font-normal text-muted">{p.owner}/</span>{p.name}</span></ExternalLink>}
  </Heading>
  {p.description && <p class="m-0 text-[0.9375rem] text-muted">{p.description}</p>}
  <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-muted">
    {p.languages.length > 0 && (
      <ul aria-label="Languages" class="m-0 flex list-none flex-wrap gap-x-3 p-0">
        {p.languages.map((l, i) => <li class:list={[i === 0 && 'text-text']}>{l}</li>)}
      </ul>
    )}
    {p.license && <span>License: {p.license}</span>}
  </div>
  {
    !compact && (hasDetails || p.homepage) && (
      <p class="relative z-10 m-0 flex flex-wrap gap-x-4 text-sm">
        {hasDetails && <ExternalLink href={p.url} newTab>{p.name} on GitHub</ExternalLink>}
        {p.homepage && <ExternalLink href={p.homepage} newTab>Demo of {p.name}</ExternalLink>}
      </p>
    )
  }
</article>
