---
import ExternalLink from './ExternalLink.astro';
import { formatDate } from '../lib/dates.ts';
import type { Project } from '../lib/projects.ts';

interface Props {
  project: Project;
  /** Heading level, to match the page outline. */
  level?: 2 | 3;
  /** Whether an MDX enrichment page exists. */
  hasDetails?: boolean;
  /** Dense variant for the home page. */
  compact?: boolean;
}
const { project: p, level = 2, hasDetails = false, compact = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const full = `${p.owner}/${p.name}`;
const stars = new Intl.NumberFormat('en-US').format(p.stars);
---

<article class:list={['flex h-full flex-col gap-3 rounded-lg border border-border bg-bg hover:border-border-ui', compact ? 'p-4' : 'p-5']}>
  <div class="flex items-start justify-between gap-3">
    <Heading class="m-0 font-mono text-base font-bold">
      <ExternalLink href={p.url} class="text-text no-underline hover:text-accent hover:underline"><span class="sr-only">{full} on GitHub</span><span aria-hidden="true"><span class="font-normal text-muted">{p.owner}/</span>{p.name}</span></ExternalLink>
    </Heading>
    <span class="flex shrink-0 items-center gap-1 font-mono text-xs text-muted">
      <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="12" height="12" fill="currentColor"><path d="M8 1l2.1 4.3 4.7.7-3.4 3.3.8 4.7L8 11.8 3.8 14l.8-4.7L1.2 6l4.7-.7z"></path></svg>
      {stars} <span class="sr-only">{p.stars === 1 ? 'star' : 'stars'}</span>
    </span>
  </div>
  {p.description && <p class="m-0 text-[0.9375rem] text-muted">{p.description}</p>}
  <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-muted">
    {p.languages.length > 0 && (
      <ul aria-label="Languages" class="m-0 flex list-none flex-wrap gap-x-3 p-0">
        {p.languages.map((l, i) => <li class:list={[i === 0 && 'text-text']}>{l}</li>)}
      </ul>
    )}
    {!compact && p.updatedAt && <span>Updated <time datetime={p.updatedAt}>{formatDate(new Date(p.updatedAt))}</time></span>}
    {p.license && <span>License: {p.license}</span>}
  </div>
  {
    !compact && (p.homepage || hasDetails) && (
      <p class="m-0 flex flex-wrap gap-x-4 text-sm">
        {p.homepage && <ExternalLink href={p.homepage}>Demo of {p.name}</ExternalLink>}
        {hasDetails && <a href={`/projects/${p.slug}/`}>Read more about {p.name}</a>}
      </p>
    )
  }
</article>
