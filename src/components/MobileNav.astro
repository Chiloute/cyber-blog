---
interface Props {
  controls: string;
}
const { controls } = Astro.props;
---

<!-- Hidden until the script runs, so the nav stays fully usable without JS. -->
<button
  type="button"
  hidden
  data-mobile-nav-button
  aria-expanded="false"
  aria-controls={controls}
  class="btn md:hidden!"
>
  <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M2 4h12M2 8h12M2 12h12" />
  </svg>
  Menu
</button>

<script>
  import '../scripts/mobile-nav.ts';
</script>
