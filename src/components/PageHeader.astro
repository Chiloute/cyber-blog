---
// Shared page heading: decorative shell kicker (or a `kicker` slot for a linked one), the page <h1>, optional lead.
interface Props { kicker?: string; title: string; lead?: string; class?: string }
const { kicker, title, lead, class: className } = Astro.props;
---
<header class:list={['max-w-[68ch]', className]}>
  <slot name="kicker">{kicker && <p class="kicker m-0" aria-hidden="true">{kicker}</p>}</slot>
  <h1 class="mt-2 text-4xl font-semibold tracking-tight">{title}</h1>
  {lead && <p class="mt-3 text-lg text-muted">{lead}</p>}
  <slot />
</header>
