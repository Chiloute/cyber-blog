---
// One log-style row: date | title + description | category, difficulty, ctf.
import Badge from './Badge.astro';
import { isoDate } from '../lib/dates.ts';
interface Props {
  href: string; title: string; description: string; date: Date; readingMinutes: number;
  category?: string | undefined; difficulty?: string | undefined; ctf?: string | undefined; tags?: string[];
  /** Heading level, to match the page outline. */
  level?: 2 | 3;
}
const { href, title, description, date, readingMinutes, category, difficulty, ctf, tags = [], level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---
<li data-post data-category={category} data-difficulty={difficulty} data-ctf={ctf}>
  <article class="group relative grid gap-x-6 gap-y-1.5 py-5 sm:grid-cols-[7.5rem_1fr] lg:grid-cols-[7.5rem_1fr_13rem]">
    <p class="m-0 font-mono text-[0.8125rem] text-muted sm:pt-1"><time datetime={isoDate(date)}>{isoDate(date)}</time></p>
    <div class="min-w-0">
      <Heading class="m-0 text-lg font-semibold leading-snug">
        <a href={href} class="text-text no-underline after:absolute after:inset-0 group-hover:text-accent group-hover:underline">{title}</a>
      </Heading>
      <p class="m-0 mt-1 text-[0.9375rem] text-muted">{description}</p>
      {tags.length > 0 && (
        <ul aria-label="Tags" class="relative z-10 m-0 mt-2 flex list-none flex-wrap gap-x-3 p-0 font-mono text-xs">
          {tags.map((t) => <li><a href={`/writeups/tags/${encodeURIComponent(t)}/`} class="target-min text-muted hover:text-accent">#{t}</a></li>)}
        </ul>
      )}
    </div>
    <p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1 sm:col-start-2 lg:col-start-3 lg:flex-col lg:items-end lg:pt-1">
      {category && <Badge kind="category" value={category} />}
      {difficulty && <Badge kind="difficulty" value={difficulty} />}
      <span class="font-mono text-xs text-muted">{ctf ? `${ctf} · ` : ''}{readingMinutes} min</span>
    </p>
  </article>
</li>
