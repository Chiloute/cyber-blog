---
interface Props { headings: { depth: number; slug: string; text: string }[] }
const hs = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
// Nest h3 under the preceding h2 (an orphan h3 starts its own group).
const groups: { h: (typeof hs)[number]; kids: typeof hs }[] = [];
for (const h of hs) {
  if (h.depth === 3 && groups.length) groups[groups.length - 1]!.kids.push(h);
  else groups.push({ h, kids: [] });
}
const link = 'target-min text-muted no-underline hover:text-accent hover:underline';
---
{hs.length >= 2 && (
  <nav aria-label="Table of contents" class="my-8 border-l-2 border-border pl-4 text-sm xl:my-0">
    <p class="kicker m-0 mb-2">Contents</p>
    <ol class="m-0 list-none space-y-1 p-0">
      {groups.map(({ h, kids }) => (
        <li>
          <a href={`#${h.slug}`} class={link}>{h.text}</a>
          {kids.length > 0 && (
            <ol class="m-0 list-none space-y-1 py-1 pl-3">
              {kids.map((k) => <li><a href={`#${k.slug}`} class={link}>{k.text}</a></li>)}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
