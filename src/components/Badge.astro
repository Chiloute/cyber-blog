---
interface Props { kind: 'category' | 'difficulty'; value: string }
const { kind, value } = Astro.props;
// Full class strings so Tailwind can see them. Text is always visible; color is supplementary.
const colors: Record<string, string> = {
  web: 'text-cat-web border-cat-web', crypto: 'text-cat-crypto border-cat-crypto', pwn: 'text-cat-pwn border-cat-pwn',
  reverse: 'text-cat-reverse border-cat-reverse', forensic: 'text-cat-forensic border-cat-forensic',
  osint: 'text-cat-osint border-cat-osint', misc: 'text-cat-misc border-cat-misc',
  easy: 'text-diff-easy border-diff-easy', medium: 'text-diff-medium border-diff-medium',
  hard: 'text-diff-hard border-diff-hard', insane: 'text-diff-insane border-diff-insane',
};
const prefix = kind === 'category' ? '#' : '▲';
---
<span class:list={['inline-flex items-center gap-1 rounded border px-2 py-0.5 font-mono text-sm', colors[value]]}>
  <span aria-hidden="true">{prefix}</span>{kind === 'difficulty' ? <span class="sr-only">Difficulty: </span> : null}{value}
</span>
