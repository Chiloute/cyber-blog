---
// Segmented control built on native radios (keyboard: arrow keys). The input is transparent but
// covers its label (still directly clickable); the label shows the focus ring via :has(:focus-visible).
const options = [
  ['light', 'Light', 'M8 3V1M8 15v-2M3 8H1m14 0h-2M4.5 4.5 3 3m10 10-1.5-1.5m0-7L13 3M3 13l1.5-1.5M8 11a3 3 0 100-6 3 3 0 000 6z'],
  ['dark', 'Dark', 'M13.5 10A6 6 0 016 2.5a6 6 0 107.5 7.5z'],
  ['system', 'System', 'M2 3h12v8H2zM6 14h4M8 11v3'],
] as const;
---

<fieldset data-theme-toggle class="m-0 flex items-center rounded-md border border-border-ui p-0.5 font-mono text-xs">
  <legend class="sr-only">Theme</legend>
  {
    options.map(([value, label, d]) => (
      <label class="target-min relative min-h-7 cursor-pointer gap-1.5 rounded px-2 text-muted hover:text-text has-checked:bg-surface has-checked:text-text has-focus-visible:outline-2 has-focus-visible:outline-focus">
        <input type="radio" name="theme" value={value} class="absolute inset-0 m-0 size-full cursor-pointer opacity-0" />
        <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d={d} /></svg>
        <span>{label}</span>
      </label>
    ))
  }
  <span role="status" aria-live="polite" class="sr-only" data-theme-status></span>
</fieldset>

<script>
  import '../scripts/theme-toggle.ts';
</script>
