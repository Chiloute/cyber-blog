---
const options = [
  ['light', 'Light'],
  ['dark', 'Dark'],
  ['system', 'System'],
] as const;
---

<fieldset data-theme-toggle class="flex flex-wrap items-center gap-x-3 border-0 p-0 text-sm">
  <legend class="sr-only">Theme</legend>
  {
    options.map(([value, label]) => (
      <label class="target-min cursor-pointer gap-1">
        <input type="radio" name="theme" value={value} class="accent-(--accent)" />
        {label}
      </label>
    ))
  }
  <span role="status" aria-live="polite" class="sr-only" data-theme-status></span>
</fieldset>

<script>
  import '../scripts/theme-toggle.ts';
</script>
