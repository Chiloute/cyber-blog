---
import ContactEmail from './ContactEmail.astro';
import ExternalLink from './ExternalLink.astro';
import { AUTHOR, licenses } from '../config/site.ts';

const links = [
  ['Legal notice', '/legal-notice'],
  ['Privacy', '/privacy'],
  ['Accessibility', '/accessibility'],
  ['Disclaimer', '/disclaimer'],
  ['Licenses', '/licenses'],
  ['RSS', '/rss.xml'],
  ['Security', '/.well-known/security.txt'],
] as const;
---

<footer class="mt-12 border-t border-(--border) px-4 py-6 text-sm">
  <div class="mx-auto max-w-5xl space-y-3">
    <nav aria-label="Footer">
      <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-1 p-0">
        {links.map(([label, href]) => <li><a href={href} class="target-min py-1">{label}</a></li>)}
      </ul>
    </nav>
    <p class="m-0">
      Content <ExternalLink href={licenses.content.url} newTab>{licenses.content.name}</ExternalLink> · Code {licenses.code.name}
    </p>
    <p class="m-0">Contact: <ContactEmail /></p>
    <p class="m-0 text-(--muted)">© {new Date().getFullYear()} {AUTHOR}</p>
  </div>
</footer>
