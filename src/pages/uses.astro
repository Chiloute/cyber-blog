---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Uses" description="Hardware, software and security tooling I use day to day." breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Uses', path: '/uses/' }]}>
  <PageHeader kicker="$ cat ~/uses.txt" title="Uses" lead="Hardware, software and security tooling I use day to day." />
  <div class="prose mt-8">
  {/* TODO: every list below is a placeholder, replace with the real setup */}
  <h2>Hardware</h2>
  <ul>
    <li>Laptop: 14-inch ultrabook, 32 GB RAM</li>
    <li>Mechanical keyboard, 75% layout</li>
    <li>External 27-inch monitor</li>
  </ul>

  <h2>OS &amp; editor</h2>
  <ul>
    <li>Linux (Debian-based) as the daily driver</li>
    <li>Neovim for quick edits, VS Code for larger projects</li>
    <li>zsh with tmux</li>
  </ul>

  <h2>Security tooling</h2>
  <ul>
    <li>Burp Suite Community for web testing</li>
    <li>Ghidra and GDB (with pwndbg) for reverse engineering</li>
    <li>Wireshark and nmap for network analysis</li>
    <li>pwntools and CyberChef for exploits and quick transformations</li>
  </ul>

  <h2>Homelab</h2>
  <div class="table-wrap">
    <table>
      <caption class="text-left text-sm text-muted">Homelab machines and their roles</caption>
      <thead>
        <tr>
          <th scope="col">Machine</th>
          <th scope="col">Role</th>
          <th scope="col">OS</th>
        </tr>
      </thead>
      <tbody>
        <tr><th scope="row">mini-pc</th><td>Self-hosted services</td><td>Debian</td></tr>
        <tr><th scope="row">pi</th><td>DNS and monitoring</td><td>Raspberry Pi OS</td></tr>
        <tr><th scope="row">vm-lab</th><td>Vulnerable VMs for practice</td><td>Various</td></tr>
      </tbody>
    </table>
  </div>
  </div>
</BaseLayout>
