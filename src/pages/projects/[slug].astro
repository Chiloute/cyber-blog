---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import PageHeader from '../../components/PageHeader.astro';
import { projects } from '../../lib/projects.ts';
import { isPublishable, showDrafts } from '../../lib/publishable.ts';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('projects', (e) => isPublishable(e.data, showDrafts()));
  return entries.flatMap((entry) => {
    const project = projects.find((p) => p.slug === entry.id);
    // The file name links the page to its repo: a mismatch must fail the build, not silently drop the page.
    if (!project) throw new Error(`[projects] ${entry.id}.mdx: no "*/${entry.id}" repo in src/data/projects.json`);
    return [{ params: { slug: entry.id }, props: { entry, project } }];
  });
}

const { entry, project: p } = Astro.props;
const { Content } = await render(entry);
const title = entry.data.title ?? p.name;
---

<BaseLayout
  title={title}
  description={p.description || `Details about ${p.name}.`}
  pagefindBody
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Projects', path: '/projects/' }, { name: title, path: `/projects/${entry.id}/` }]}
>
  <PageHeader kicker={`~/projects/${entry.id}`} title={title} {...(p.description ? { lead: p.description } : {})}>
    <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm text-muted">
      {p.languages.length > 0 && <span>{p.languages.join(' · ')}</span>}
      {p.license && <span>License: {p.license}</span>}
      <ExternalLink href={p.url} newTab>{p.owner}/{p.name} on GitHub</ExternalLink>
      {p.homepage && <ExternalLink href={p.homepage} newTab>Demo</ExternalLink>}
    </p>
  </PageHeader>
  <div class="prose mt-8"><Content /></div>
  <script>
    import '../../scripts/copy-code.ts';
  </script>
</BaseLayout>
