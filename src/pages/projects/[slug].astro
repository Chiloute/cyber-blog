---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getProjects } from '../../lib/github.ts';
import { showDrafts } from '../../lib/publishable.ts';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const [projects, entries] = await Promise.all([getProjects(), getCollection('projects', (e) => showDrafts() || !e.data.draft)]);
  return entries.flatMap((entry) => {
    const project = projects.find((p) => p.slug === entry.id);
    return project ? [{ params: { slug: entry.id }, props: { entry, project } }] : [];
  });
}

const { entry, project } = Astro.props;
const { Content } = await render(entry);
const title = entry.data.title ?? project.name;
---

<BaseLayout
  title={title}
  description={project.description || `Details about ${project.name}.`}
  pagefindBody
  breadcrumbs={[{ name: 'Projects', path: '/projects/' }, { name: title, path: `/projects/${entry.id}/` }]}
>
  <PageHeader kicker={`~/projects/${entry.id}`} title={title} />
  <div class="my-8 max-w-xl"><ProjectCard project={project} level={2} /></div>
  <div class="prose"><Content /></div>
</BaseLayout>
