---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <h1 class="text-3xl font-bold"><span aria-hidden="true" class="font-mono text-muted">$ cd ~<br /></span>404 — Page not found</h1>
  <p class="mt-4 max-w-prose">The page you are looking for does not exist or has moved. Try one of these instead:</p>
  <ul class="mt-4 list-disc pl-6">
    <li><a href="/" class="text-accent underline">Home</a></li>
    <li><a href="/writeups/" class="text-accent underline">Writeups</a></li>
    <li><a href="/search/" class="text-accent underline">Search</a></li>
  </ul>
</BaseLayout>
