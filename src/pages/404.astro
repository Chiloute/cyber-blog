---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
const links = [['Home', '/'], ['Writeups', '/writeups/'], ['Notes', '/notes/'], ['Search', '/search/']] as const;
---
<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <PageHeader kicker="$ cd ~  # 404" title="404 — Page not found" lead="The page you are looking for does not exist or has moved." />
  <div class="mt-8 max-w-xl rounded-lg border border-border bg-surface font-mono text-sm">
    <p aria-hidden="true" class="m-0 border-b border-border px-4 py-2 text-xs text-muted">try one of these</p>
    <ul class="m-0 list-none space-y-1 p-4">
      {links.map(([label, href]) => <li><span aria-hidden="true" class="text-muted">$ cd&nbsp;</span><a href={href} class="target-min">{label}</a></li>)}
    </ul>
  </div>
</BaseLayout>
