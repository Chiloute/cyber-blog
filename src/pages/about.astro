---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ContactEmail from '../components/ContactEmail.astro';
import PageHeader from '../components/PageHeader.astro';
import { cv, certifications, ctfProfiles, socialLinks } from '../config/site.ts';

const certs = certifications.filter((c) => c.enabled);
const ctf = ctfProfiles.filter((c) => c.enabled);
const skills = ['Web application security', 'Reverse engineering', 'Binary exploitation', 'Cryptography', 'Digital forensics', 'Linux and scripting (Python, Bash)'];
---
<BaseLayout title="About" description="About chiloute: background, skills, certifications and CTF profiles." breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]}>
  {/* TODO: write the real bio (pseudonym only, no real name) */}
  <PageHeader kicker="$ whoami" title="About" lead="I am chiloute, a security enthusiast who learns by breaking things in controlled environments and writing down what worked." />
  <div class="prose mt-8">
  <p>This blog collects my CTF writeups, short notes and the small projects I build along the way.</p>

  <h2>Skills</h2>
  <ul>{skills.map((s) => <li>{s}</li>)}</ul>

  <h2>Certifications</h2>
  {certs.length === 0 ? <p>Certifications will be listed here.</p> : (
    <ul>
      {certs.map((c) => (
        <li>{c.name}, {c.issuer}, {c.year}. <ExternalLink href={c.verifyUrl} newTab>Verify {c.name} on {c.issuer}</ExternalLink></li>
      ))}
    </ul>
  )}

  <h2>CV</h2>
  {cv.path ? (
    <p><a href={cv.path} download>Download CV (PDF)</a> <span class="text-sm text-muted">(PDF{/* TODO: add file size, e.g. ", 120 KB" */})</span></p>
  ) : (
    <p>CV available on request: <ContactEmail /></p>
  )}

  {ctf.length > 0 && (
    <>
      <h2>CTF profiles</h2>
      <ul>
        {ctf.map((c) => <li><ExternalLink href={c.url} newTab>{c.name}</ExternalLink></li>)}
      </ul>
    </>
  )}

  <h2>Elsewhere</h2>
  <ul>
    {socialLinks.map((l) => <li><ExternalLink href={l.url} newTab>{l.name}</ExternalLink></li>)}
  </ul>
  </div>
</BaseLayout>
