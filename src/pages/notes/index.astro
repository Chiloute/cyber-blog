---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublished } from '../../lib/publishable.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

const entries = await getPublished('notes');
---
<BaseLayout
  title="Notes"
  description="Short notes and cheatsheets."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Notes', path: '/notes/' }]}
>
  <header class="max-w-[60ch]">
    <p class="kicker m-0" aria-hidden="true">$ ls -lt ~/notes</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">Notes</h1>
    <p class="mt-3 text-muted">Short notes and cheatsheets.</p>
  </header>
  <ul class="log mt-8">
    {entries.map((e) => (
      <PostCard
        href={`/notes/${e.id}/`} title={e.data.title} description={e.data.description} date={e.data.date}
        readingMinutes={readingMinutes(e.body ?? '')}
      />
    ))}
  </ul>
  <p hidden={entries.length > 0 ? true : undefined} class="mt-6 text-muted">No notes published yet.</p>
</BaseLayout>
