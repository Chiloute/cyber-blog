---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPublished } from '../../lib/publishable.ts';
import { postUrl } from '../../lib/urls.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

const entries = await getPublished('notes');
---
<BaseLayout
  title="Notes"
  description="Short notes and cheatsheets."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Notes', path: '/notes/' }]}
>
  <PageHeader kicker="$ ls -lt ~/notes" title="Notes" lead="Short notes and cheatsheets." />
  <ul class="log mt-8">
    {entries.map((e) => (
      <PostCard
        href={postUrl('notes', e.id)} title={e.data.title} description={e.data.description} date={e.data.date}
        readingMinutes={readingMinutes(e.body ?? '')}
      />
    ))}
  </ul>
  <p hidden={entries.length > 0 ? true : undefined} class="mt-6 text-muted">No notes published yet.</p>
</BaseLayout>
