---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/publishable.ts';
import { formatDate, isoDate } from '../../lib/dates.ts';

// Notes carry no category/difficulty/ctf, so PostCard (writeup-only props) does not fit: simple list item.
const entries = await getPublished('notes');
---
<BaseLayout
  title="Notes"
  description="Short notes and cheatsheets."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Notes', path: '/notes/' }]}
>
  <h1 class="text-3xl font-bold">Notes</h1>
  <p class="mt-2">Short notes and cheatsheets.</p>
  <ul class="mt-6 list-none space-y-4 p-0">
    {entries.map((e) => (
      <li>
        <article class="rounded border border-border p-4">
          <h2 class="m-0 text-xl font-bold"><a href={`/notes/${e.id}/`} class="text-accent underline">{e.data.title}</a></h2>
          <p class="mt-2">{e.data.description}</p>
          <time class="mt-1 block text-sm text-muted" datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time>
        </article>
      </li>
    ))}
  </ul>
  <p hidden={entries.length > 0 ? true : undefined} class="mt-6">No notes published yet.</p>
</BaseLayout>
