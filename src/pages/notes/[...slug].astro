---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { Callout, Flag, Terminal, Spoiler } from '../../components/mdx/index.ts';
import { postPaths } from '../../lib/publishable.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

export const getStaticPaths = () => postPaths('notes');
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---
<PostLayout
  kind="note" id={entry.id} title={d.title} description={d.description} date={d.date} updated={d.updated}
  tags={d.tags} readingMinutes={readingMinutes(entry.body ?? '')} headings={headings} prev={prev} next={next}
>
  <Content components={{ Callout, Flag, Terminal, Spoiler }} />
</PostLayout>
