---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublished } from '../../lib/publishable.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

export async function getStaticPaths() {
  const list = await getPublished('notes'); // newest first
  const link = (e?: (typeof list)[number]) => (e ? { title: e.data.title, href: `/notes/${e.id}/` } : undefined);
  return list.map((entry, i) => ({
    params: { slug: entry.id },
    // previous = published before (older), next = published after (newer)
    props: { entry, prev: link(list[i + 1]), next: link(list[i - 1]) },
  }));
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---
<PostLayout
  kind="note" id={entry.id} title={d.title} description={d.description} date={d.date} updated={d.updated}
  tags={d.tags} readingMinutes={readingMinutes(entry.body ?? '')} headings={headings} prev={prev} next={next}
>
  <Content />
</PostLayout>
