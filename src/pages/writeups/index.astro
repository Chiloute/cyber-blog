---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublished } from '../../lib/publishable.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

const entries = await getPublished('writeups');
const uniq = (f: (e: (typeof entries)[number]) => string) => [...new Set(entries.map(f))].sort();
const filters = [
  { name: 'category', label: 'Category', values: uniq((e) => e.data.category) },
  { name: 'difficulty', label: 'Difficulty', values: uniq((e) => e.data.difficulty) },
  { name: 'ctf', label: 'CTF', values: uniq((e) => e.data.ctf) },
];
const select = 'min-h-9 rounded-md border border-border-ui bg-bg px-2 font-mono text-sm text-text';
---
<BaseLayout
  title="Writeups"
  description="CTF writeups: web, pwn, crypto, forensics, reverse engineering and more."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Writeups', path: '/writeups/' }]}
>
  <header class="max-w-[60ch]">
    <p class="kicker m-0" aria-hidden="true">$ ls -lt ~/writeups</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">Writeups</h1>
    <p class="mt-3 text-muted">Solutions to CTF challenges, written to be reproduced step by step. Published once each event's rules allow it.</p>
  </header>
  <form role="search" aria-label="Filter writeups" data-filters hidden class="mt-8 flex flex-wrap items-end gap-4 rounded-lg border border-border bg-surface p-4">
    {filters.map((f) => (
      <div class="flex flex-col gap-1">
        <label for={`f-${f.name}`} class="kicker">{f.label}</label>
        <select id={`f-${f.name}`} name={f.name} class={select}>
          <option value="">All</option>
          {f.values.map((v) => <option value={v}>{v}</option>)}
        </select>
      </div>
    ))}
    <button type="reset" class="btn min-h-9">Reset</button>
    <p role="status" aria-live="polite" data-count hidden class="m-0 ml-auto self-center font-mono text-xs text-muted" data-total={entries.length}></p>
  </form>
  <ul class="log mt-8" data-list>
    {entries.map((e) => (
      <PostCard
        href={`/writeups/${e.id}/`} title={e.data.title} description={e.data.description} date={e.data.date}
        readingMinutes={readingMinutes(e.body ?? '')} category={e.data.category} difficulty={e.data.difficulty}
        ctf={e.data.ctf} tags={e.data.tags}
      />
    ))}
  </ul>
  <p data-empty hidden={entries.length > 0 ? true : undefined} class="mt-6 text-muted">
    {entries.length === 0 ? 'No writeups published yet.' : 'No writeups match these filters.'}
  </p>
  <script>
    import '../../scripts/filters.ts';
  </script>
</BaseLayout>
