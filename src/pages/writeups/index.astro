---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Badge from '../../components/Badge.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPublished } from '../../lib/publishable.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

const entries = await getPublished('writeups');
const uniq = (f: (e: (typeof entries)[number]) => string) => [...new Set(entries.map(f))].sort();
const severity = ['easy', 'medium', 'hard', 'insane'];
const filters = [
  { name: 'category', values: uniq((e) => e.data.category) },
  { name: 'difficulty', values: uniq((e) => e.data.difficulty).sort((a, b) => severity.indexOf(a) - severity.indexOf(b)) },
  { name: 'ctf', values: uniq((e) => e.data.ctf) },
] as const;
// Chip = native radio stretched over its label (same pattern as ThemeToggle); active state matches the header nav.
const chip = 'relative inline-flex min-h-7 cursor-pointer items-center rounded px-1.5 hover:bg-surface has-checked:bg-highlight-bg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus';
const radio = 'absolute inset-0 m-0 size-full cursor-pointer appearance-none opacity-0';
---
<BaseLayout
  title="Writeups"
  description="CTF writeups: web, pwn, crypto, forensics, reverse engineering and more."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Writeups', path: '/writeups/' }]}
>
  <PageHeader kicker="$ ls -lt ~/writeups" title="Writeups" lead="Solutions to CTF challenges, written to be reproduced step by step. Published once each event's rules allow it." />
  {entries.length > 0 && (
    <form role="search" aria-label="Filter writeups" data-filters hidden autocomplete="off" class="mt-8 space-y-1.5 font-mono text-[0.8125rem]">
      {filters.map((f) => (
        <fieldset data-filter={f.name} class="m-0 border-0 p-0">
          <legend class="kicker float-left w-24 pt-1">{f.name}</legend>
          <div class="flex flex-wrap gap-x-1 gap-y-1">
            <label class:list={[chip, 'text-muted has-checked:text-text']}>
              <input type="radio" name={f.name} value="" checked class={radio} />all
            </label>
            {f.values.map((v) => (
              <label class:list={[chip, f.name === 'ctf' && 'text-text']}>
                <input type="radio" name={f.name} value={v} class={radio} />
                {f.name === 'ctf' ? v : <Badge kind={f.name} value={v} />}
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="flex min-h-8 flex-wrap items-center gap-x-4 gap-y-1 pt-4">
        <!-- Echo of the active filters as the listing command; the status line below carries the information. -->
        <p data-echo aria-hidden="true" hidden class="m-0 min-w-0 text-text"></p>
        <p role="status" aria-live="polite" data-count hidden class="m-0 text-xs text-muted"></p>
        <button type="reset" data-clear hidden class="btn btn-sm">Clear filters</button>
      </div>
    </form>
  )}
  <ul class="log mt-8 [form:not([hidden])+&]:mt-2" data-list>
    {entries.map((e) => (
      <PostCard
        href={`/writeups/${e.id}/`} title={e.data.title} description={e.data.description} date={e.data.date}
        readingMinutes={readingMinutes(e.body ?? '')} category={e.data.category} difficulty={e.data.difficulty}
        ctf={e.data.ctf} tags={e.data.tags}
      />
    ))}
  </ul>
  <p data-empty hidden={entries.length > 0 ? true : undefined} class="mt-6 text-muted">
    {entries.length === 0 ? 'No writeups published yet.' : 'No writeups match these filters.'}
  </p>
  <script>
    import '../../scripts/filters.ts';
  </script>
</BaseLayout>
