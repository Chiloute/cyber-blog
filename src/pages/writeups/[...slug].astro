---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { Callout, Flag, Terminal, Spoiler } from '../../components/mdx/index.ts';
import { postPaths } from '../../lib/publishable.ts';
import { readingMinutes } from '../../lib/reading-time.ts';

export const getStaticPaths = () => postPaths('writeups');
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---
<PostLayout
  kind="writeup" id={entry.id} title={d.title} description={d.description} date={d.date} updated={d.updated}
  tags={d.tags} readingMinutes={readingMinutes(entry.body ?? '')} headings={headings} prev={prev} next={next}
  writeup={{ ctf: d.ctf, category: d.category, difficulty: d.difficulty, points: d.points, team: d.team }}
>
  <Content components={{ Callout, Flag, Terminal, Spoiler }} />
</PostLayout>
