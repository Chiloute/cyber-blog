---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { formatDate } from '../lib/dates.ts';

interface Props {
  title: string;
  description: string;
  /** ISO date (YYYY-MM-DD). */
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description} pagefindBody={false}>
  <PageHeader kicker="$ cat ~/legal" title={title}>
    <p class="kicker mt-3">Last updated: <time datetime={updated}>{formatDate(new Date(updated))}</time></p>
  </PageHeader>
  <article class="prose mt-8">
    <slot />
  </article>
</BaseLayout>
