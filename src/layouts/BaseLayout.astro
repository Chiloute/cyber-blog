---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import type { SEOProps } from '../components/SEO.astro';
import ThemeScript from '../components/ThemeScript.astro';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SHIKI_CSS_PATH } from '../integrations/shiki-css.mjs';

interface Props extends SEOProps {
  /** Index <main> in Pagefind. Content pages opt in. */
  pagefindBody?: boolean;
}
const { pagefindBody = false, ...seo } = Astro.props;
---

<html lang="en" data-theme="light">
  <head>
    <ThemeScript />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href={SHIKI_CSS_PATH} />
    <SEO {...seo} />
  </head>
  <body class="flex min-h-screen flex-col">
    <SkipLink />
    <Header />
    <main id="main" tabindex="-1" class="shell flex-1 py-10 md:py-14" data-pagefind-body={pagefindBody ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
