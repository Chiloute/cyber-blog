---
// MDX headings start at h2: the page <h1> is the title rendered here.
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/Badge.astro';
import PageHeader from '../components/PageHeader.astro';
import Disclaimer from '../components/Disclaimer.astro';
import TOC from '../components/TOC.astro';
import PrevNext from '../components/PrevNext.astro';
import { formatDate, isoDate } from '../lib/dates.ts';
import { ogPath, postUrl, tagUrl } from '../lib/urls.ts';

export interface PostLayoutProps {
  kind: 'writeup' | 'note';
  /** Collection entry id (slug); used for the OG image path. */
  id: string;
  title: string;
  description: string;
  date: Date;
  updated?: Date | undefined;
  tags: string[];
  readingMinutes: number;
  headings: { depth: number; slug: string; text: string }[];
  prev?: { title: string; href: string } | undefined;
  next?: { title: string; href: string } | undefined;
  /** Writeup-only meta; omit for notes. */
  writeup?: { ctf: string; category: string; difficulty: string; points?: number | undefined; team?: string | undefined } | undefined;
}
const p = Astro.props as PostLayoutProps;
const section = p.kind === 'writeup' ? 'writeups' : 'notes'; // same value as the PostCollection type
const base = Astro.site!;
const ogImage = new URL(ogPath(section, p.id), base).href;
const w = p.writeup;
const hasToc = p.headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 2;
const dt = 'kicker';
const dd = 'm-0 text-[0.9375rem]';
---
<BaseLayout
  title={p.title}
  description={p.description}
  type="article"
  pagefindBody
  publishedTime={p.date}
  {...(p.updated ? { modifiedTime: p.updated } : {})}
  tags={p.tags}
  ogImage={ogImage}
  ogImageAlt={p.title}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: p.kind === 'writeup' ? 'Writeups' : 'Notes', path: `/${section}/` },
    { name: p.title, path: postUrl(section, p.id) },
  ]}
>
  <article class:list={['grid gap-x-14', hasToc && 'xl:grid-cols-[minmax(0,1fr)_15rem]']}>
    <PageHeader title={p.title} lead={p.description} class="xl:col-span-2">
      <p slot="kicker" class="kicker m-0"><a href={`/${section}/`} class="text-muted no-underline hover:text-accent hover:underline">~/{section}</a><span aria-hidden="true">/{p.id}</span></p>
      <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-border py-5 sm:grid-cols-3 md:grid-cols-4">
        {w && <div><dt class={dt}>CTF</dt><dd class={dd}>{w.ctf}</dd></div>}
        {w && <div><dt class={dt}>Category</dt><dd class={dd}><Badge kind="category" value={w.category} /></dd></div>}
        {w && <div><dt class={dt}>Difficulty</dt><dd class={dd}><Badge kind="difficulty" value={w.difficulty} /></dd></div>}
        {w?.points !== undefined && <div><dt class={dt}>Points</dt><dd class={dd}>{w.points}</dd></div>}
        {w?.team && <div><dt class={dt}>Team</dt><dd class={dd}>{w.team}</dd></div>}
        <div><dt class={dt}>Published</dt><dd class={dd}><time datetime={isoDate(p.date)}>{formatDate(p.date)}</time></dd></div>
        {p.updated && <div><dt class={dt}>Updated</dt><dd class={dd}><time datetime={isoDate(p.updated)}>{formatDate(p.updated)}</time></dd></div>}
        <div><dt class={dt}>Reading time</dt><dd class={dd}>{p.readingMinutes}&nbsp;min</dd></div>
      </dl>
      {p.tags.length > 0 && (
        <ul aria-label="Tags" class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0 font-mono text-xs">
          {p.tags.map((t) => (
            <li>{p.kind === 'writeup'
              ? <a href={tagUrl(t)} class="target-min rounded border border-border px-2 text-muted no-underline hover:border-accent hover:text-accent">#{t}</a>
              : <span class="inline-flex rounded border border-border px-2 text-muted">#{t}</span>}</li>
          ))}
        </ul>
      )}
      {p.kind === 'writeup' && <Disclaimer />}
    </PageHeader>
    {hasToc && (
      <aside class="xl:col-start-2 xl:row-start-2">
        <div class="xl:sticky xl:top-6"><TOC headings={p.headings} /></div>
      </aside>
    )}
    <div class="min-w-0 xl:col-start-1 xl:row-start-2">
      <div class="prose">
        <slot />
      </div>
      <PrevNext kind={p.kind} prev={p.prev} next={p.next} />
    </div>
  </article>
  <script>
    import '../scripts/copy-code.ts';
  </script>
</BaseLayout>
