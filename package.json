{
  "name": "blog",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test 'src/**/*.test.ts'",
    "test:a11y": "playwright test",
    "check:drafts": "node scripts/check-drafts.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "build:test": "BLOG_TEST_DRAFTS=1 astro build --outDir dist-test && pagefind --site dist-test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "rehype-external-links": "^3.0.0",
    "tailwindcss": "^4.3.4"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pagefind": "^1.6.0",
    "satori": "^0.63.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
